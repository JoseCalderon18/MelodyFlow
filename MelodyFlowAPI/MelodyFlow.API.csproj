<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>melodyflow-api-local-development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\MelodyFlow.Application\MelodyFlow.Application.csproj" />
    <ProjectReference Include="..\MelodyFlow.Contracts\MelodyFlow.Contracts.csproj" />
    <ProjectReference Include="..\MelodyFlow.Infrastructure\MelodyFlow.Infrastructure.csproj" />
  </ItemGroup>

</Project>
